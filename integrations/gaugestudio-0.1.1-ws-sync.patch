diff --git a/electron/services/ws-client.js b/electron/services/ws-client.js
new file mode 100644
index 0000000..2af9940
--- /dev/null
+++ b/electron/services/ws-client.js
@@ -0,0 +1,121 @@
+import WebSocket from 'ws'
+
+/**
+ * WebSocket client that dials studio-reporter's listen URL
+ * (printed as `studio-reporter websocket: ws://127.0.0.1:<port>`).
+ */
+export class WsClient {
+  constructor() {
+    this.ws = null
+    this.url = null
+    this.port = 0
+    this.runId = null
+    this.onEvent = null
+    this.onConnectionChange = null
+    this.connected = false
+    this.#closedByUs = false
+  }
+
+  #closedByUs = false
+
+  setRunId(runId) {
+    this.runId = runId
+  }
+
+  async connect(url, { timeoutMs = 8000 } = {}) {
+    await this.close()
+    this.#closedByUs = false
+    if (!url) throw new Error('missing websocket url')
+    this.url = url
+    const m = String(url).match(/:(\d+)\s*$/)
+    this.port = m ? Number(m[1]) : 0
+
+    return new Promise((resolve, reject) => {
+      let settled = false
+      const timer = setTimeout(() => {
+        if (settled) return
+        settled = true
+        try {
+          this.ws?.terminate()
+        } catch {
+          /* ignore */
+        }
+        reject(new Error(`connect timeout: ${url}`))
+      }, timeoutMs)
+
+      try {
+        const ws = new WebSocket(url)
+        this.ws = ws
+        ws.on('open', () => {
+          if (settled) return
+          settled = true
+          clearTimeout(timer)
+          this.connected = true
+          this.onConnectionChange?.(1, { url: this.url, port: this.port, mode: 'client' })
+          resolve({ url: this.url, port: this.port })
+        })
+        ws.on('message', (data) => this.#handleMessage(data))
+        ws.on('close', () => {
+          this.connected = false
+          this.onConnectionChange?.(0, { url: this.url, port: this.port, mode: 'client' })
+          if (!settled && !this.#closedByUs) {
+            settled = true
+            clearTimeout(timer)
+            reject(new Error(`websocket closed before open: ${url}`))
+          }
+        })
+        ws.on('error', (err) => {
+          if (!settled) {
+            settled = true
+            clearTimeout(timer)
+            reject(err)
+          }
+        })
+      } catch (err) {
+        clearTimeout(timer)
+        reject(err)
+      }
+    })
+  }
+
+  #handleMessage(data) {
+    let raw
+    try {
+      raw = JSON.parse(data.toString())
+    } catch {
+      return
+    }
+    if (!raw || typeof raw.type !== 'string') return
+    let payload = raw.payload
+    if (typeof payload === 'string') {
+      try {
+        payload = JSON.parse(payload)
+      } catch {
+        /* keep string */
+      }
+    }
+    this.onEvent?.({
+      runId: this.runId,
+      type: raw.type,
+      timestamp: raw.timestamp || new Date().toISOString(),
+      payload: payload || {}
+    })
+  }
+
+  async close() {
+    this.#closedByUs = true
+    const ws = this.ws
+    this.ws = null
+    this.connected = false
+    if (!ws) return
+    await new Promise((resolve) => {
+      try {
+        ws.once('close', () => resolve())
+        ws.close()
+        setTimeout(resolve, 200)
+      } catch {
+        resolve()
+      }
+    })
+  }
+}
