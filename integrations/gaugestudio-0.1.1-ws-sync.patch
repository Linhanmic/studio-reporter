+/** Match studio-reporter stdout discovery line (API.md). */
+export const REPORTER_WS_LINE_RE =
+  /studio-reporter websocket:\s*(ws:\/\/127\.0\.0\.1:\d+)/i
+
+export function extractReporterWsUrl(text) {
