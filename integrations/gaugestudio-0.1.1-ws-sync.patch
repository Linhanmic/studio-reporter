+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { extractReporterWsUrl, REPORTER_WS_LINE_RE } from '../shared/constants.js'
+
+test('extractReporterWsUrl parses plugin discovery line', () => {
+  const url = extractReporterWsUrl(
+    'info\nstudio-reporter websocket: ws://127.0.0.1:45678\nmore'
+  )
+  assert.equal(url, 'ws://127.0.0.1:45678')
+  assert.ok(REPORTER_WS_LINE_RE.test('studio-reporter websocket: ws://127.0.0.1:9'))
+})
+
+test('extractReporterWsUrl ignores unrelated output', () => {
+  assert.equal(extractReporterWsUrl('gauge run specs'), null)
+  assert.equal(extractReporterWsUrl(''), null)
+})
