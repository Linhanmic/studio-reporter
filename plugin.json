{
  "id": "studio-reporter",
  "version": "0.5.2",
  "name": "Studio Reporter",
  "description": "Desktop-bound report tool: Gauge plugin WS bridge + local HTML/PDF; Desktop App is the product surface.",
  "capabilities": [
    "grpc_support"
  ],
  "command": {
    "windows": [
      "bin/studio-reporter.exe",
      "--start"
    ],
    "linux": [
      "bin/studio-reporter",
      "--start"
    ],
    "darwin": [
      "bin/studio-reporter",
      "--start"
    ]
  },
  "scope": [
    "execution"
  ],
  "gaugeVersionSupport": {
    "minimum": "1.0.7",
    "maximum": ""
  }
}
