{
  "id": "studio-reporter",
  "version": "0.5.0",
  "name": "Studio Reporter",
  "description": "Standalone test report tool with Gauge plugin mode: live WebSocket forwarding and local HTML/PDF reports.",
  "capabilities": [
    "grpc_support"
  ],
  "command": {
    "windows": [
      "bin/studio-reporter.exe",
      "--start"
    ],
    "linux": [
      "bin/studio-reporter",
      "--start"
    ],
    "darwin": [
      "bin/studio-reporter",
      "--start"
    ]
  },
  "scope": [
    "execution"
  ],
  "gaugeVersionSupport": {
    "minimum": "1.0.7",
    "maximum": ""
  }
}
